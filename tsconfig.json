{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@app/config": ["libs/config/src"],
      "@app/config/*": ["libs/config/src/*"],
      "@app/contracts": ["libs/contracts/src"],
      "@app/contracts/*": ["libs/contracts/src/*"],
      "@app/kafka": ["libs/kafka/src"],
      "@app/kafka/*": ["libs/kafka/src/*"],
      "@app/opensearch": ["libs/opensearch/src"],
      "@app/opensearch/*": ["libs/opensearch/src/*"],
      "@app/redis": ["libs/redis/src"],
      "@app/redis/*": ["libs/redis/src/*"],
      "@app/api-gateway": ["apps/api-gateway/src"],
      "@app/api-gateway/*": ["apps/api-gateway/src/*"],
      "@app/order-producer-microservice": ["apps/order-producer-microservice/src"],
      "@app/order-producer-microservice/*": ["apps/order-producer-microservice/src/*"],
      "@app/order-consumer-microservice": ["apps/order-consumer-microservice/src"],
      "@app/order-consumer-microservice/*": ["apps/order-consumer-microservice/src/*"],
      "@app/inventory-consumer-microservice": ["apps/inventory-consumer-microservice/src"],
      "@app/inventory-consumer-microservice/*": ["apps/inventory-consumer-microservice/src/*"],
      "@app/payment-consumer-microservice": ["apps/payment-consumer-microservice/src"],
      "@app/payment-consumer-microservice/*": ["apps/payment-consumer-microservice/src/*"],
      "@app/shipping-consumer-microservice": ["apps/shipping-consumer-microservice/src"],
      "@app/shipping-consumer-microservice/*": ["apps/shipping-consumer-microservice/src/*"],
      "@app/messageria-consumer-microservice": ["apps/messageria-consumer-microservice/src"],
      "@app/messageria-consumer-microservice/*": ["apps/messageria-consumer-microservice/src/*"],
      "@app/order-read-model-consumer-microservice": ["apps/order-read-model-consumer-microservice/src"],
      "@app/order-read-model-consumer-microservice/*": ["apps/order-read-model-consumer-microservice/src/*"],
      "@app/opensearch-consumer-microservice": ["apps/opensearch-consumer-microservice/src"],
      "@app/opensearch-consumer-microservice/*": ["apps/opensearch-consumer-microservice/src/*"]
    }
  }
}