# Kafka. Local: localhost:9092. Docker: kafka:19092
KAFKA_BROKERS=localhost:9092
KAFKAJS_NO_PARTITIONER_WARNING=1

# OpenSearch. Local: localhost:9200. Docker: http://opensearch:9200
OPENSEARCH_NODE=http://localhost:9200

# Redis. Local: localhost:6379. Docker: redis://redis:6379
REDIS_URL=redis://localhost:6379

# HTTP port (api-gateway=3000, order-producer=3001)
PORT=3000

# Order HTTP service URL for api-gateway. Local: localhost:3001. Docker: http://order-producer-microservice:3001
ORDER_SERVICE_URL=http://localhost:3001

# Per-service DBs (Docker compose sets these; for local dev use init-multiple-dbs.sh then these URLs)
ORDER_DATABASE_URL=postgresql://order_user:order_pass@localhost:5432/order_db
INVENTORY_DATABASE_URL=postgresql://inventory_user:inventory_pass@localhost:5432/inventory_db
PAYMENT_DATABASE_URL=postgresql://payment_user:payment_pass@localhost:5432/payment_db
SHIPPING_DATABASE_URL=postgresql://shipping_user:shipping_pass@localhost:5432/shipping_db
MESSAGERIA_DATABASE_URL=postgresql://messageria_user:messageria_pass@localhost:5432/messageria_db
